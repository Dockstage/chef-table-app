{
  "name": "chef-table",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "eslint App.tsx index.ts src tests --max-warnings=0",
    "lint:fix": "eslint App.tsx index.ts src tests --fix --max-warnings=0",
    "format": "prettier --write App.tsx index.ts src tests eslint.config.js package.json tsconfig.json app.json",
    "format:check": "prettier --check App.tsx index.ts src tests eslint.config.js package.json tsconfig.json app.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.25",
    "expo-notifications": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
